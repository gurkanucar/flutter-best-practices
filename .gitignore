migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Localization (gen-l10n report of missing translations)
untranslated.json

# Environment files: dev/staging are committed; prod and personal overrides are not.
# Copy env/prod.example.json → env/prod.json locally or create it in CI.
env/prod.json
env/*.local.json

# Obfuscation symbols from --split-debug-info (upload to crash reporting, don't commit)
/build-symbols/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
