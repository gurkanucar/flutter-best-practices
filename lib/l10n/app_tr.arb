{
  "@@locale": "tr",

  "appTitle": "Flutter Best Practices",
  "@appTitle": { "description": "App name shown in task switcher / browser tab" },

  "language": "Dil",
  "@language": { "description": "Tooltip of the language selector" },

  "systemLanguage": "Sistem dili",
  "@systemLanguage": { "description": "Language menu item that follows the device language" },

  "hello": "Merhaba!",
  "@hello": { "description": "A simple greeting" },

  "welcome": "Hoş geldin, {name}!",
  "@welcome": {
    "placeholders": { "name": { "type": "String", "example": "John" } }
  },

  "itemCount": "{count, plural, =0{Öğe yok} =1{1 öğe} other{{count} öğe}}",
  "@itemCount": {
    "placeholders": { "count": { "type": "int" } }
  },

  "userRole": "{role, select, admin{Yönetici} user{Kullanıcı} other{Misafir}}",
  "@userRole": {
    "placeholders": { "role": { "type": "String" } }
  },

  "lastLogin": "Son giriş: {date}",
  "@lastLogin": {
    "placeholders": { "date": { "type": "DateTime", "format": "yMMMd" } }
  },

  "price": "Fiyat: {amount}",
  "@price": {
    "placeholders": {
      "amount": {
        "type": "double",
        "format": "currency",
        "optionalParameters": { "name": "TRY", "decimalDigits": 2 }
      }
    }
  },

  "notifications": "Bildirimler",
  "@notifications": { "description": "Title of the notification demo section" },

  "notificationChannelName": "Genel",
  "@notificationChannelName": { "description": "Android notification channel name, shown in system app settings" },

  "showNotification": "Bildirim göster",
  "@showNotification": { "description": "Button that shows a notification immediately" },

  "scheduleNotification": "{seconds} saniye sonra planla",
  "@scheduleNotification": {
    "description": "Button that schedules a notification",
    "placeholders": { "seconds": { "type": "int" } }
  },

  "cancelNotifications": "Tümünü iptal et",
  "@cancelNotifications": { "description": "Button that cancels all notifications" },

  "notificationTitle": "Flutter Best Practices'ten merhaba",
  "@notificationTitle": { "description": "Title of the demo notification" },

  "notificationBody": "Bu bir yerel bildirim.",
  "@notificationBody": { "description": "Body of the demo notification" },

  "notificationScheduled": "Bildirim {seconds} saniye sonra gösterilecek",
  "@notificationScheduled": {
    "description": "Snackbar after scheduling a notification",
    "placeholders": { "seconds": { "type": "int" } }
  },

  "notificationPermissionDenied": "Bildirim izni verilmedi",
  "@notificationPermissionDenied": { "description": "Snackbar when the user denies notification permission" },

  "schedulingNotSupported": "Planlı bildirimler bu platformda desteklenmiyor",
  "@schedulingNotSupported": { "description": "Shown on web and Linux, which have no scheduler" },

  "lastTappedNotification": "Son dokunulan bildirim: {payload}",
  "@lastTappedNotification": {
    "description": "Payload of the notification the user tapped",
    "placeholders": { "payload": { "type": "String", "example": "demo-now" } }
  },

  "setAlarm": "Tarih ve saatte alarm kur",
  "@setAlarm": { "description": "Button that opens date and time pickers to schedule an alarm" },

  "alarmChannelName": "Alarmlar",
  "@alarmChannelName": { "description": "Android notification channel name for alarms, shown in system app settings" },

  "alarmTitle": "Alarm",
  "@alarmTitle": { "description": "Title of the alarm notification" },

  "alarmBody": "Zaman doldu!",
  "@alarmBody": { "description": "Body of the alarm notification" },

  "alarmScheduled": "Alarm kuruldu: {date} {time}",
  "@alarmScheduled": {
    "description": "Snackbar after an exact alarm was scheduled",
    "placeholders": {
      "date": { "type": "DateTime", "format": "yMMMd" },
      "time": { "type": "DateTime", "format": "jm" }
    }
  },

  "alarmTimeInPast": "İleri bir zaman seç",
  "@alarmTimeInPast": { "description": "Snackbar when the picked alarm time has already passed" },

  "alarmInexact": "Tam zamanlı alarm izni verilmedi — alarm gecikebilir",
  "@alarmInexact": { "description": "Snackbar when Android exact alarms aren't allowed and the alarm was scheduled inexact" }
}
