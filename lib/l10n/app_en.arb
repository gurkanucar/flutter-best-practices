{
  "@@locale": "en",

  "appTitle": "Flutter Best Practices",
  "@appTitle": { "description": "App name shown in task switcher / browser tab" },

  "language": "Language",
  "@language": { "description": "Tooltip of the language selector" },

  "systemLanguage": "System language",
  "@systemLanguage": { "description": "Language menu item that follows the device language" },

  "hello": "Hello!",
  "@hello": { "description": "A simple greeting" },

  "welcome": "Welcome, {name}!",
  "@welcome": {
    "placeholders": { "name": { "type": "String", "example": "John" } }
  },

  "itemCount": "{count, plural, =0{No items} =1{1 item} other{{count} items}}",
  "@itemCount": {
    "placeholders": { "count": { "type": "int" } }
  },

  "userRole": "{role, select, admin{Administrator} user{User} other{Guest}}",
  "@userRole": {
    "placeholders": { "role": { "type": "String" } }
  },

  "lastLogin": "Last login: {date}",
  "@lastLogin": {
    "placeholders": { "date": { "type": "DateTime", "format": "yMMMd" } }
  },

  "price": "Price: {amount}",
  "@price": {
    "placeholders": {
      "amount": {
        "type": "double",
        "format": "currency",
        "optionalParameters": { "name": "TRY", "decimalDigits": 2 }
      }
    }
  },

  "notifications": "Notifications",
  "@notifications": { "description": "Title of the notification demo section" },

  "notificationChannelName": "General",
  "@notificationChannelName": { "description": "Android notification channel name, shown in system app settings" },

  "showNotification": "Show notification",
  "@showNotification": { "description": "Button that shows a notification immediately" },

  "scheduleNotification": "Schedule in {seconds} seconds",
  "@scheduleNotification": {
    "description": "Button that schedules a notification",
    "placeholders": { "seconds": { "type": "int" } }
  },

  "cancelNotifications": "Cancel all",
  "@cancelNotifications": { "description": "Button that cancels all notifications" },

  "notificationTitle": "Hello from Flutter Best Practices",
  "@notificationTitle": { "description": "Title of the demo notification" },

  "notificationBody": "This is a local notification.",
  "@notificationBody": { "description": "Body of the demo notification" },

  "notificationScheduled": "Notification scheduled in {seconds} seconds",
  "@notificationScheduled": {
    "description": "Snackbar after scheduling a notification",
    "placeholders": { "seconds": { "type": "int" } }
  },

  "notificationPermissionDenied": "Notification permission denied",
  "@notificationPermissionDenied": { "description": "Snackbar when the user denies notification permission" },

  "schedulingNotSupported": "Scheduled notifications are not supported on this platform",
  "@schedulingNotSupported": { "description": "Shown on web and Linux, which have no scheduler" },

  "lastTappedNotification": "Last tapped notification: {payload}",
  "@lastTappedNotification": {
    "description": "Payload of the notification the user tapped",
    "placeholders": { "payload": { "type": "String", "example": "demo-now" } }
  }
}
